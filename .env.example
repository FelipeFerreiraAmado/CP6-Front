# Copie este arquivo para .env e defina a sua própria senha.
#
# Senha de acesso à mesa (/game). Sem ela, o login não autentica ninguém.
# Gere uma senha aleatória com:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
VITE_GAME_PASSWORD=troque-por-uma-senha-aleatoria
